{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/waitlist",
      "destination": "https://app.pasi.capital",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
